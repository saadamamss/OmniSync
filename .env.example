# Frontend (safe, public — bundled by Vite into client code)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ============================================================
# ⚠️ NEVER put real values for the keys below in a VITE_ var.
# They are NOT read by the frontend and would be bundled into
# the public client bundle. They live in Supabase Edge Function
# secrets only:
#   supabase secrets set GROQ_API_KEY / STRIPE_SECRET_KEY /
#                        STRIPE_WEBHOOK_SECRET / OPENAI_API_KEY
# ============================================================
